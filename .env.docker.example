# Use URL-safe characters for these values because they are also used in the database URL.
PROMPTCHIVED_DB_NAME=promptchived
PROMPTCHIVED_DB_USER=promptchived
PROMPTCHIVED_DB_PASSWORD=replace-this-password

# These folders may be on different drives. They become /sources/chatgpt and
# /sources/gemini inside the web and worker containers.
PROMPTCHIVED_CHATGPT_EXPORT_PATH=./archives/chatgpt
PROMPTCHIVED_GEMINI_EXPORT_PATH=./archives/gemini
PROMPTCHIVED_TIMEZONE=Asia/Jakarta
